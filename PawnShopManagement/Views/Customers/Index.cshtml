@model List<Customer>
@{ ViewData["Title"]=T("Khách hàng"); int page=ViewBag.Page; int pages=ViewBag.Pages; }
<div class="page-heading"><div><div class="eyebrow">@T("KẾT NỐI & CHĂM SÓC")</div><h1>@T("Khách hàng")</h1><p>@T("Quản lý thông tin liên hệ và hồ sơ khách hàng.")</p></div><a asp-action="Create" class="btn btn-primary">@T("＋ Thêm khách hàng")</a></div>
<section class="panel"><div class="panel-heading"><h2>@T("Danh bạ khách hàng")</h2><span class="subtle-badge">@T("Số khách hàng", (int)ViewBag.Total)</span></div><form method="get" class="filter-bar"><div class="search-field"><span>⌕</span><label class="visually-hidden" for="search">@T("Tìm khách hàng")</label><input id="search" name="search" value="@ViewBag.Search" placeholder="@T("Tìm tên, số điện thoại, CCCD…")"/></div><button class="btn btn-filter">@T("Tìm kiếm")</button><a asp-action="Index" class="reset-link">@T("Đặt lại")</a></form>
<div class="table-responsive"><table class="data-table"><thead><tr><th>@T("Khách hàng")</th><th>@T("CCCD / CMND")</th><th>@T("Điện thoại")</th><th>@T("Địa chỉ")</th><th class="text-end">@T("Thao tác")</th></tr></thead><tbody>
@foreach(var c in Model) { <tr><td><div class="customer-cell"><span class="mini-avatar">@c.FullName.FirstOrDefault()</span><span>@c.FullName<small>KH-@c.CustomerID.ToString("D4")</small></span></div></td><td>@c.IdentityCard</td><td>@c.Phone</td><td>@c.Address</td><td><div class="row-actions"><a class="btn-edit" asp-action="Edit" asp-route-id="@c.CustomerID">@T("Sửa")</a>@if(User.IsInRole("Admin")) { <form asp-action="Delete" asp-route-id="@c.CustomerID" method="post" data-confirm="@T("Xóa khách hàng này?")"><button type="submit" class="btn-delete">@T("Xóa")</button></form> }</div></td></tr> }
@if(Model.Count==0) { <tr><td colspan="5"><div class="empty-state"><h3>@T("Chưa có khách hàng phù hợp")</h3><p>@T("Thêm khách hàng để bắt đầu lập hợp đồng.")</p></div></td></tr> }
</tbody></table></div><div class="table-footer"><span>@T("Trang hiện tại", page, pages)</span><nav class="pagination-controls" aria-label="@T("Phân trang")">@if(page>1) {<a asp-route-page="@(page-1)" asp-route-search="@ViewBag.Search">@T("← Trước")</a>}<span class="page-current">@(page)</span>@if(page<pages) {<a asp-route-page="@(page+1)" asp-route-search="@ViewBag.Search">@T("Sau →")</a>}</nav></div></section>

