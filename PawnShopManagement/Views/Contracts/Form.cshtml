@model PawnContract
@{ var edit=Model.ContractID>0; ViewData["Title"]=edit?T("Chỉnh sửa hợp đồng"):T("Tạo hợp đồng"); }
<a asp-action="Index" class="back-link">@T("← Danh sách hợp đồng")</a>
<div class="page-heading"><div><div class="eyebrow">@T("Hợp đồng cầm đồ")</div><h1>@ViewData["Title"]</h1><p>@T("Kiểm tra thông tin khách hàng và tài sản trước khi lưu.")</p></div></div>
<div class="form-layout"><section class="panel form-panel"><form asp-action="@(edit?"Edit":"Create")" asp-route-id="@(edit?Model.ContractID:(int?)null)" method="post">
<input asp-for="ContractID" type="hidden"/><div asp-validation-summary="All" class="text-danger validation-box"></div>
<h2><span class="step-number">01</span> @T("Khách hàng & tài sản")</h2><div class="field"><label asp-for="CustomerID"></label><select asp-for="CustomerID" asp-items="ViewBag.CustomerID" class="form-select"><option value="">@T("Chọn khách hàng")</option></select><span asp-validation-for="CustomerID"></span><small>@T("Chưa có khách hàng?") <a asp-controller="Customers" asp-action="Create">@T("Thêm khách hàng")</a></small></div>
<div class="field"><label asp-for="AssetName"></label><input asp-for="AssetName" class="form-control" placeholder="@T("Ví dụ: Honda SH 125i")"/><span asp-validation-for="AssetName"></span></div>
<div class="field"><label asp-for="AssetDetails"></label><textarea asp-for="AssetDetails" class="form-control" rows="3" placeholder="@T("Tình trạng, biển số, số khung hoặc IMEI…")"></textarea><span asp-validation-for="AssetDetails"></span></div>
<h2 class="section-divider"><span class="step-number">02</span> @T("Thông tin khoản vay")</h2><div class="field-grid"><div class="field"><label asp-for="LoanAmount"></label><input id="LoanAmount" name="LoanAmount" value="@Model.LoanAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="500000" max="1000000000" step="1" class="form-control"/><span asp-validation-for="LoanAmount"></span></div><div class="field"><label asp-for="InterestRate"></label><input name="InterestRate" id="InterestRate" value="@Model.InterestRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="100" step="0.01" class="form-control"/><span asp-validation-for="InterestRate"></span></div><div class="field"><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" max="@ContractDeadlines.Today.ToString("yyyy-MM-dd")" min="2000-01-01" class="form-control"/><span asp-validation-for="StartDate"></span></div><div class="field"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option value="DangCam">@T("Đang cầm")</option><option value="DaChuoc">@T("Đã chuộc")</option><option value="DaThanhLy">@T("Đã thanh lý")</option></select><span asp-validation-for="Status"></span></div></div>
<div class="field-grid"><div class="field"><label asp-for="TermDays"></label><input asp-for="TermDays" type="number" min="1" max="3650" step="1" class="form-control" required/><span asp-validation-for="TermDays"></span><small>@T("Hợp đồng mới mặc định 30 ngày; có thể thay đổi.")</small></div><div class="field"><label for="due-date-preview">@T("Ngày đến hạn")</label><output id="due-date-preview" class="due-date-preview" aria-live="polite">@(Model.DueDate?.ToString("dd/MM/yyyy")??T("Chưa xác định"))</output><small>@T("Ngày đến hạn = ngày cầm + thời hạn. Cảnh báo trước 3 ngày.")</small></div></div>
<div class="form-footer"><a asp-action="Index" class="btn btn-light">@T("Hủy bỏ")</a><button class="btn btn-primary" type="submit">@T("✓ Lưu hợp đồng")</button></div>
</form></section><aside class="help-card"><span class="help-icon">◇</span><h3>@T("Thông tin rõ ràng,")<br/>@T("giao dịch an tâm.")</h3><p>@T("Ghi đầy đủ đặc điểm nhận dạng và tình trạng tài sản để thuận tiện khi đối chiếu.")</p><hr/><small>@T("TIỀN LÃI DỰ KIẾN / THÁNG")</small><strong id="interest-preview">0 đ</strong><p class="fine-print">@T("Số tiền vay × lãi suất / 100. Chỉ là ước tính, chưa bao gồm phí hoặc điều chỉnh theo thỏa thuận.")</p></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
