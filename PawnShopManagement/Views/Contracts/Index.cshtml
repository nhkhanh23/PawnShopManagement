@model ContractListModel
@using System.Globalization
@{ var en=CultureInfo.CurrentUICulture.Name=="en-US"; ViewData["Title"]=en?"Contracts":T("Hợp đồng cầm đồ"); }
<div class="page-heading"><div><div class="eyebrow">@T("TỔNG QUAN HOẠT ĐỘNG")</div><h1>@(en?"Contract management":T("Quản lý hợp đồng"))</h1><p>@T("Theo dõi tài sản, khoản vay và trạng thái hợp đồng của bạn.")</p></div><a asp-action="Create" class="btn btn-primary">＋ @(en?"New contract":T("Tạo hợp đồng"))</a></div>
<div class="stats-grid">
 <article class="stat-card"><div class="stat-top"><span>@T("Dư nợ đang cầm")</span><span class="stat-icon mint">₫</span></div><strong>@Model.Capital.ToString("N0") <small>đ</small></strong><p>@T("Tổng vốn trong các hợp đồng đang cầm")</p></article>
 <article class="stat-card"><div class="stat-top"><span>@T("Hợp đồng đang cầm")</span><span class="stat-icon blue">▤</span></div><strong>@Model.Active.ToString("N0")</strong><p><span class="live-dot"></span> @T("Đang theo dõi tài sản")</p></article>
 <article class="stat-card"><div class="stat-top"><span>@T("Hợp đồng đã chuộc")</span><span class="stat-icon violet">✓</span></div><strong>@Model.Redeemed.ToString("N0")</strong><p>@T("Khách hàng đã nhận lại tài sản")</p></article>
</div>
<section class="panel"><div class="panel-heading"><div><h2>@(en?"All contracts":T("Danh sách hợp đồng"))</h2><p>@T("Tìm kiếm và quản lý thông tin giao dịch")</p></div><span class="subtle-badge">@T("10 / trang")</span></div>
<form asp-action="Index" method="get" class="filter-bar" id="contract-filter"><div class="search-field"><span aria-hidden="true">⌕</span><label class="visually-hidden" for="search">@T("Tìm hợp đồng")</label><input id="search" name="searchString" value="@Model.Search" placeholder="@T("Tìm tên khách hàng, tài sản…")" maxlength="150"/></div><label class="visually-hidden" for="status">@T("Trạng thái")</label><select id="status" name="statusFilter" class="form-select"><option value="">@T("Tất cả trạng thái")</option><option value="DangCam" selected="@(Model.Status=="DangCam")">@T("Đang cầm")</option><option value="DaChuoc" selected="@(Model.Status=="DaChuoc")">@T("Đã chuộc")</option><option value="DaThanhLy" selected="@(Model.Status=="DaThanhLy")">@T("Đã thanh lý")</option></select><label class="visually-hidden" for="deadline">@T("Hạn hợp đồng")</label><select id="deadline" name="deadlineFilter" class="form-select"><option value="">@T("Tất cả hạn")</option><option value="Overdue" selected="@(Model.Deadline=="Overdue")">@T("Quá hạn")</option><option value="DueToday" selected="@(Model.Deadline=="DueToday")">@T("Đến hạn hôm nay")</option><option value="DueSoon" selected="@(Model.Deadline=="DueSoon")">@T("Sắp đến hạn")</option></select><button class="btn btn-filter" type="submit">@T("Lọc kết quả")</button><a asp-action="Index" class="reset-link">@T("Đặt lại")</a></form>
<div id="results" aria-live="polite"><partial name="_Results" model="Model"/></div></section>
